# Copie este arquivo para `.env.local` e preencha com os dados do seu projeto Supabase.
# Painel do Supabase → Project Settings → API.

# URL do projeto (ex.: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (Publishable key, começa com sb_publishable_). Pode ser exposta no navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do site (usada em metadados e links absolutos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp da instituição (botão "Tenho interesse" na página de cada animal).
# Formato internacional: código do país + DDD + número. Ex.: 5511999998888
# (pontuação como "+55 (11) 99999-8888" também é aceita). Vazio = botão desativado.
INSTITUTION_WHATSAPP=
